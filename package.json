{
  "name": "silkllm-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "SilkLLM Frontend — Admin Dashboard, User Dashboard, and Landing Page",
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run seo:generate && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "seo:generate": "node scripts/generate-sitemap.mjs",
    "seo:indexnow": "node scripts/indexnow-submit.mjs",
    "audit:layout": "vite build && node scripts/audit-layout.mjs",
    "audit:pwa": "vite build && node scripts/audit-pwa.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.40.0",
    "axios": "^1.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.383.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.23.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
