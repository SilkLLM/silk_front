{
  "name": "SilkLLM",
  "short_name": "SilkLLM",
  "description": "One key for every AI model. Text, image, audio and video from every major provider, with one balance.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0D0F10",
  "theme_color": "#0D0F10",
  "lang": "en",
  "dir": "ltr",
  "categories": ["developer", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Chat",
      "short_name": "Chat",
      "description": "Talk to any model",
      "url": "/dashboard/chat",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Usage",
      "short_name": "Usage",
      "description": "Spend and activity",
      "url": "/dashboard/usage",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Add credits",
      "short_name": "Billing",
      "description": "Top up your balance",
      "url": "/dashboard/billing",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
